---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Javier Oskar — Front End Developer">
	<main class="min-h-screen bg-slate-950 px-6 py-10 text-slate-100 sm:px-10 lg:px-16">
		<div class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-5xl flex-col justify-between">

			<nav>
				<span class="text-lg font-semibold tracking-tight">Javier Oskar</span>
			</nav>

			<section class="py-20">
				<p class="mb-5 text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">
					Front End Developer
				</p>

				<h1 class="max-w-4xl text-5xl font-bold tracking-tight text-white sm:text-7xl">
					Javier Oskar
				</h1>

				<p class="mt-6 max-w-2xl text-xl leading-8 text-slate-300">
					I’m currently working at LeadVenture as a Front End Developer.
				</p>

				<p class="mt-4 max-w-2xl text-lg leading-8 text-slate-400">
					This project will be a playground for building, testing, and developing
					reusable web components.
				</p>
			</section>

			<footer class="border-t border-slate-800 py-6 text-sm text-slate-500">
				<span>© 2026 Javier Oskar · LeadVenture</span>
			</footer>

		</div>
	</main>
</Layout>